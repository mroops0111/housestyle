{
  "description": "Repair comment layout after every write, and block only on a finding that needs rewriting.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-housestyle-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
